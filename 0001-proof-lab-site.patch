+              <button className="tk-mono-btn" onClick={next}>next draw ▸</button>
+              <button className="tk-mono-btn" onClick={onClose}>esc</button>
+            </div>
+          </div>
+        </div>
+      </div>
+    </React.Fragment>
+  );
+}
