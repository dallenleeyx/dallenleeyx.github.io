diff --git a/tracker.css b/tracker.css
new file mode 100644
--- /dev/null
+++ b/tracker.css
@@ -0,0 +1,184 @@
+/* tracker.css — The Proof Lab. Extends colors_and_type.css tokens. */
+*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
+html{scroll-behavior:smooth;}
+body{background:var(--bg);color:var(--fg-1);font-family:var(--font-sans);font-size:16px;line-height:var(--lh-relaxed);min-height:100vh;overflow-x:hidden;}
+::selection{background:var(--fg-1);color:var(--bg);}
+::-webkit-scrollbar{width:10px;}
+::-webkit-scrollbar-thumb{background:var(--border);border-radius:5px;}
+::-webkit-scrollbar-track{background:transparent;}
+.katex{font-size:1.02em;}
+#particles{position:fixed;inset:0;pointer-events:none;z-index:0;opacity:.45;}
+@keyframes spinRing{to{transform:rotate(360deg);}}
+@keyframes fadeUp{from{opacity:0;transform:translateY(18px);}to{opacity:1;transform:translateY(0);}}
+@keyframes fadeIn{from{opacity:0;}to{opacity:1;}}
+.fade-up{animation:fadeUp .5s ease both;}
+.d1{animation-delay:.06s;}.d2{animation-delay:.12s;}.d3{animation-delay:.18s;}.d4{animation-delay:.24s;}
+
+.math-deco{font-family:var(--font-mono);font-size:.68rem;color:var(--border);position:fixed;bottom:2rem;left:.8rem;writing-mode:vertical-rl;letter-spacing:.12em;user-select:none;pointer-events:none;z-index:0;}
+
+/* Layout */
+.tk-app{display:flex;min-height:100vh;position:relative;}
+.tk-main{margin-left:var(--sidebar-w);flex:1;padding:3.2rem 4rem 6rem;max-width:960px;position:relative;z-index:1;}
+
+/* Sidebar */
+.tk-sidebar{width:var(--sidebar-w);min-width:var(--sidebar-w);background:var(--surface);border-right:1px solid var(--border);position:fixed;top:0;left:0;bottom:0;display:flex;flex-direction:column;padding:2.2rem 1.6rem 1.6rem;overflow-y:auto;z-index:100;}
+.tk-brand{display:flex;align-items:center;gap:.85rem;margin-bottom:1.4rem;}
+.tk-avatar{width:52px;height:52px;position:relative;flex-shrink:0;}
+.tk-avatar-glyph{position:absolute;inset:4px;border-radius:50%;background:var(--surface-2);display:flex;align-items:center;justify-content:center;font-family:var(--font-mono);font-size:1rem;color:var(--accent);z-index:1;}
+.tk-avatar-ring{position:absolute;inset:0;border-radius:50%;border:2px solid transparent;background:conic-gradient(from 0deg,var(--accent),var(--accent-2),var(--accent-3),var(--accent)) border-box;-webkit-mask:linear-gradient(#fff 0 0) padding-box,linear-gradient(#fff 0 0);-webkit-mask-composite:xor;mask-composite:exclude;animation:spinRing 6s linear infinite;}
+.tk-brand-name{font-size:1.02rem;font-weight:800;line-height:1.15;letter-spacing:-.01em;color:var(--fg-1);}
+.tk-brand-sub{font-family:var(--font-mono);font-size:.6rem;color:var(--fg-muted);margin-top:.2rem;letter-spacing:.05em;}
+.tk-nav{list-style:none;margin:0 0 .4rem;}
+.tk-nav li{margin-bottom:2px;}
+.tk-nav a{display:flex;align-items:center;gap:.55rem;padding:.42rem .65rem;font-size:.72rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--fg-muted);text-decoration:none;border-radius:var(--radius-sm);cursor:pointer;transition:all var(--transition-fast);}
+.tk-nav a:hover{color:var(--fg-1);background:var(--surface-2);}
+.tk-nav a.active{color:var(--accent);background:var(--surface-2);}
+.tk-nav .dot{width:5px;height:5px;border-radius:50%;background:var(--border);flex-shrink:0;transition:all var(--transition-fast);}
+.tk-nav a.active .dot{background:var(--accent);transform:scale(1.5);}
+.tk-nav .count{margin-left:auto;font-family:var(--font-mono);font-size:.58rem;font-weight:400;color:var(--border);letter-spacing:0;}
+.tk-nav a.active .count{color:var(--accent-2);}
+.tk-sidebar-foot{font-family:var(--font-mono);font-size:.58rem;color:var(--fg-muted);letter-spacing:.03em;margin-top:auto;padding-top:1.2rem;line-height:1.7;}
+
+/* Calendar */
+.tk-cal{margin-top:1.4rem;padding-top:1.2rem;border-top:1px solid var(--border);}
+.tk-cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem;}
+.tk-cal-label{font-family:var(--font-mono);font-size:.66rem;font-weight:500;color:var(--accent-2);letter-spacing:.08em;}
+.tk-cal-btn{background:transparent;border:1px solid var(--border);color:var(--fg-muted);width:20px;height:20px;border-radius:6px;cursor:pointer;font-size:11px;line-height:1;padding:0;transition:all var(--transition-fast);}
+.tk-cal-btn:hover{border-color:var(--accent);color:var(--accent);}
+.tk-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:2px;}
+.tk-cal-dow{text-align:center;font-family:var(--font-mono);font-size:.52rem;color:var(--fg-muted);}
+.tk-cal-cell{height:26px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:1px;border-radius:6px;font-family:var(--font-mono);font-size:.58rem;color:var(--fg-2);user-select:none;cursor:pointer;border:1px solid transparent;transition:all var(--transition-fast);}
+.tk-cal-cell:hover{background:var(--surface-2);}
+.tk-cal-cell.out{color:var(--border);cursor:default;}
+.tk-cal-cell.out:hover{background:transparent;}
+.tk-cal-cell.today{background:var(--accent);color:var(--bg);}
+.tk-cal-cell.selected{background:var(--surface-2);border-color:var(--fg-muted);}
+.tk-cal-cell .due-dot{width:3px;height:3px;border-radius:50%;background:var(--accent);display:block;}
+.tk-cal-cell.today .due-dot{background:var(--bg);}
+.tk-cal-detail{margin-top:.7rem;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.6rem .7rem;animation:fadeIn .25s ease both;}
+.tk-cal-detail-date{font-family:var(--font-mono);font-size:.6rem;color:var(--fg-muted);margin-bottom:.35rem;}
+.tk-cal-detail-row{display:flex;align-items:baseline;gap:.45rem;margin-bottom:.25rem;}
+.tk-cal-detail-row .glyph{font-family:var(--font-mono);font-size:.6rem;color:var(--accent-2);flex-shrink:0;}
+.tk-cal-detail-row .title{font-size:.68rem;color:var(--fg-2);line-height:1.4;}
+.tk-cal-detail-empty{font-size:.66rem;color:var(--fg-muted);}
+
+/* Headers, sections */
+.tk-hero{display:flex;align-items:flex-start;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;}
+.tk-hero h1{font-size:2.3rem;font-weight:800;line-height:1.15;letter-spacing:-.03em;margin-bottom:.4rem;}
+.tk-hero h1 em{font-style:normal;color:var(--accent);border-bottom:2px solid var(--glow-strong);}
+.tk-hero-meta{font-family:var(--font-mono);font-size:.72rem;color:var(--fg-muted);}
+.tk-section-label{font-size:.68rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);margin-bottom:1.4rem;padding-bottom:.65rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.6rem;}
+.tk-section-label .sub{font-family:var(--font-mono);font-size:.62rem;font-weight:400;color:var(--fg-muted);letter-spacing:.03em;text-transform:none;}
+.tk-course-head{display:flex;align-items:baseline;gap:.85rem;margin-bottom:.4rem;}
+.tk-course-glyph{font-family:var(--font-mono);font-size:1.5rem;color:var(--accent);}
+.tk-course-name{font-size:1.9rem;font-weight:800;letter-spacing:-.025em;}
+
+/* Buttons */
+.tk-btn{font-family:var(--font-sans);font-weight:800;font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;padding:.65rem 1.3rem;border-radius:var(--radius-sm);cursor:pointer;transition:all .2s ease;border:none;}
+.tk-btn-primary{background:var(--accent);color:var(--bg);}
+.tk-btn-primary:hover{transform:translateY(-2px);box-shadow:0 6px 24px var(--glow-strong);}
+.tk-btn-outline{background:transparent;color:var(--fg-1);border:1px solid var(--border);}
+.tk-btn-outline:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 6px 24px var(--glow);}
+.tk-btn-sm{padding:.55rem 1.15rem;font-size:.7rem;}
+.tk-mono-btn{background:transparent;border:1px solid var(--border);color:var(--accent-2);font-family:var(--font-mono);font-size:.66rem;padding:.32rem .75rem;border-radius:6px;cursor:pointer;transition:all var(--transition-fast);}
+.tk-mono-btn:hover{border-color:var(--accent);color:var(--accent);}
+.tk-x-btn{background:transparent;border:1px solid var(--border);color:var(--fg-muted);width:24px;height:24px;border-radius:6px;cursor:pointer;font-size:14px;line-height:1;transition:all var(--transition-fast);}
+.tk-x-btn:hover{border-color:var(--accent);color:var(--accent);}
+
+/* Stats */
+.tk-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;margin:2.2rem 0 3.2rem;}
+.tk-stat{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.2rem 1.4rem;transition:all var(--transition);}
+.tk-stat:hover{border-color:var(--accent-2);transform:translateY(-2px);box-shadow:0 6px 28px var(--glow);}
+.tk-stat-num{font-family:var(--font-mono);font-size:1.9rem;font-weight:500;color:var(--accent);line-height:1;}
+.tk-stat-num span{font-size:1rem;color:var(--fg-muted);}
+.tk-stat-cap{font-size:.66rem;color:var(--fg-muted);text-transform:uppercase;letter-spacing:.08em;margin-top:.45rem;}
+
+/* Timeline queue */
+.tk-timeline{position:relative;padding-left:44px;margin-bottom:1.1rem;}
+.tk-timeline::before{content:'';position:absolute;left:10px;top:10px;bottom:20px;width:1px;background:linear-gradient(to bottom,var(--border),transparent);}
+.tk-tl-item{position:relative;margin-bottom:.85rem;}
+.tk-tl-item::before{content:'';position:absolute;left:-38px;top:1.1rem;width:9px;height:9px;border-radius:50%;border:1.5px solid var(--fg-muted);background:var(--bg);z-index:1;transition:all .2s;}
+.tk-tl-item:hover::before{transform:scale(1.4);border-color:var(--fg-1);background:var(--fg-1);}
+.tk-row-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:.9rem 1.2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;transition:all var(--transition);}
+.tk-row-card:hover{border-color:var(--accent-2);transform:translateY(-2px);box-shadow:0 6px 28px var(--glow);}
+.tk-row-title{font-size:.88rem;font-weight:700;color:var(--fg-1);transition:all var(--transition);}
+.tk-row-title.done{text-decoration:line-through;color:var(--fg-muted);}
+.tk-row-meta{font-family:var(--font-mono);font-size:.64rem;color:var(--fg-muted);margin-top:.25rem;}
+.tk-row-actions{display:flex;align-items:center;gap:.5rem;flex-shrink:0;}
+
+/* Pills */
+.tk-pill{font-family:var(--font-mono);font-size:.6rem;font-weight:700;letter-spacing:.06em;padding:.28rem .65rem;border-radius:var(--radius-pill);cursor:pointer;transition:all var(--transition-fast);background:transparent;}
+.tk-pill.todo{border:1px dashed var(--fg-muted);color:var(--fg-muted);}
+.tk-pill.doing{border:1px solid var(--accent-2);color:var(--accent-2);background:var(--glow);}
+.tk-pill.done{border:1px solid var(--accent);color:var(--bg);background:var(--accent);}
+.tk-days{font-family:var(--font-mono);font-size:.6rem;padding:.24rem .55rem;border-radius:var(--radius-pill);white-space:nowrap;border:1px solid var(--border);color:var(--fg-muted);}
+.tk-days.soon{border-color:var(--fg-muted);color:var(--accent-2);}
+.tk-days.today{border-color:var(--accent-3);color:var(--accent-3);background:var(--glow);}
+.tk-days.overdue{border-color:var(--fg-1);color:var(--fg-1);background:var(--glow-strong);}
+
+/* Forms */
+.tk-form-row{display:flex;gap:.6rem;margin-bottom:3.2rem;}
+.tk-input{flex:1;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.55rem .8rem;font-family:var(--font-sans);font-size:.82rem;color:var(--fg-1);outline:none;transition:all .2s ease;}
+.tk-input:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--glow);}
+.tk-input-date{flex:0 0 155px;font-family:var(--font-mono);font-size:.72rem;color-scheme:dark;}
+[data-theme="light"] .tk-input-date{color-scheme:light;}
+.tk-textarea{width:100%;background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-md);padding:.75rem .9rem;font-family:var(--font-mono);font-size:.78rem;line-height:1.6;color:var(--fg-1);outline:none;resize:vertical;min-height:72px;transition:all .2s ease;}
+.tk-textarea:focus{border-color:var(--accent);box-shadow:0 0 0 3px var(--glow);}
+.tk-select{background:var(--surface-2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:.5rem .6rem;font-family:var(--font-mono);font-size:.72rem;color:var(--fg-1);outline:none;}
+
+/* Canon / arena cards */
+.tk-card{background:var(--surface);border:1px solid var(--border);border-left:2px solid var(--border);border-radius:var(--radius-lg);padding:1.25rem 1.5rem;transition:all var(--transition);}
+.tk-card:hover{border-color:var(--accent-2);border-left-color:var(--accent);transform:translateY(-2px);box-shadow:0 6px 28px var(--glow);}
+.tk-card-head{display:flex;align-items:center;gap:.6rem;margin-bottom:.55rem;flex-wrap:wrap;}
+.tk-type{font-size:.58rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;padding:.18rem .58rem;border-radius:var(--radius-pill);border:1px solid var(--border);background:var(--surface-2);color:var(--accent-2);}
+.tk-card-name{font-size:.95rem;font-weight:700;color:var(--fg-1);}
+.tk-card-body{font-size:.88rem;color:var(--fg-2);line-height:1.7;}
+.tk-reveal{margin-top:.85rem;padding:.85rem 1rem;background:var(--bg);border:1px solid var(--border);border-radius:var(--radius-md);font-size:.85rem;color:var(--fg-2);line-height:1.7;animation:fadeIn .25s ease both;}
+.tk-stack{display:flex;flex-direction:column;gap:.7rem;margin-bottom:3.2rem;}
+
+/* Progress */
+.tk-progress{height:3px;background:var(--border);border-radius:2px;overflow:hidden;}
+.tk-progress-fill{height:100%;background:var(--accent);border-radius:2px;transition:width .5s ease;}
+
+/* Jump-in grid */
+.tk-jump-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:.7rem;}
+.tk-jump{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.15rem 1.3rem;cursor:pointer;transition:all var(--transition);}
+.tk-jump:hover{border-color:var(--accent);transform:translateY(-2px);box-shadow:0 8px 32px var(--glow);}
+.tk-jump-glyph{font-family:var(--font-mono);font-size:.95rem;color:var(--accent);margin-bottom:.4rem;}
+.tk-jump-name{font-size:.87rem;font-weight:700;color:var(--fg-1);}
+.tk-jump-meta{font-family:var(--font-mono);font-size:.62rem;color:var(--fg-muted);margin:.3rem 0 .75rem;}
+
+/* Notes */
+.tk-note{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-md);padding:.85rem 1.05rem;position:relative;transition:all var(--transition);}
+.tk-note:hover{border-color:var(--accent-2);}
+.tk-note-date{font-family:var(--font-mono);font-size:.62rem;color:var(--fg-muted);margin-bottom:.35rem;}
+.tk-note-text{font-size:.85rem;color:var(--fg-2);line-height:1.65;padding-right:1.6rem;}
+.tk-note .tk-x-btn{position:absolute;top:.7rem;right:.7rem;width:22px;height:22px;font-size:13px;}
+.tk-note-head{display:flex;align-items:center;gap:.6rem;margin-bottom:.35rem;}
+.tk-note-head .glyph{font-family:var(--font-mono);font-size:.68rem;color:var(--accent-2);}
+.tk-note-head .course{font-size:.64rem;color:var(--fg-muted);text-transform:uppercase;letter-spacing:.05em;}
+.tk-note-head .date{font-family:var(--font-mono);font-size:.62rem;color:var(--fg-muted);}
+.tk-note-actions{display:flex;justify-content:flex-end;margin:.7rem 0 1.4rem;}
+
+/* Empty states */
+.tk-empty{text-align:center;padding:2.5rem 2rem;border:1px dashed var(--border);border-radius:var(--radius-lg);color:var(--fg-muted);}
+.tk-empty .icon{font-size:1.6rem;margin-bottom:.5rem;}
+.tk-empty .title{font-weight:700;color:var(--fg-2);}
+
+/* Quiz modal */
+.tk-quiz-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(6px);z-index:300;animation:fadeIn .2s ease both;}
+.tk-quiz-wrap{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;z-index:301;pointer-events:none;}
+.tk-quiz{pointer-events:auto;width:min(640px,92vw);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:1.8rem 2rem;box-shadow:0 20px 60px rgba(0,0,0,.5);animation:fadeUp .3s ease both;}
+.tk-quiz-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.1rem;}
+.tk-quiz-eyebrow{font-size:.62rem;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);}
+.tk-quiz-course{font-family:var(--font-mono);font-size:.64rem;color:var(--fg-muted);}
+.tk-quiz-name{font-size:1.05rem;font-weight:700;color:var(--fg-1);}
+.tk-quiz-body{font-size:.9rem;color:var(--fg-2);line-height:1.75;min-height:3.2rem;}
+.tk-quiz-foot{display:flex;justify-content:space-between;align-items:center;margin-top:1.4rem;gap:.6rem;}
+
+@media (max-width: 900px){
+  .tk-sidebar{position:static;width:100%;min-width:0;border-right:none;border-bottom:1px solid var(--border);}
+  .tk-app{flex-direction:column;}
+  .tk-main{margin-left:0;padding:2rem 1.4rem 4rem;}
+  .tk-stats{grid-template-columns:1fr;}
+}
diff --git a/tracker-data.js b/tracker-data.js
new file mode 100644
--- /dev/null
+++ b/tracker-data.js
@@ -0,0 +1,56 @@
+// tracker-data.js — seed content for The Proof Lab. Edit freely; your live
+// edits are kept in localStorage, this file only seeds the first visit.
+window.TRACKER_SEED = [
+  {
+    id: 'algtop', name: 'Algebraic Topology', glyph: 'π₁', nickname: 'Alg Top',
+    assignments: [
+      { id: 'at1', title: 'Problem Set 3 — Van Kampen & pushouts', due: '2026-08-10', status: 'doing' },
+      { id: 'at2', title: 'Problem Set 4 — CW complexes', due: '2026-08-24', status: 'todo' },
+      { id: 'at3', title: 'Problem Set 2 — Homotopy lifting', due: '2026-07-28', status: 'done' },
+    ],
+    theorems: [
+      { id: 'att1', type: 'Theorem', name: "Van Kampen's Theorem", statement: 'If $X = U \\cup V$ with $U, V$ open and path-connected and $U \\cap V$ path-connected, then $\\pi_1(X) \\cong \\pi_1(U) *_{\\pi_1(U\\cap V)} \\pi_1(V)$.', proof: 'Build the pushout of groupoids induced by the cover, then pass to fundamental groups — the amalgam records loops that stay in $U$, stay in $V$, or cross through $U \\cap V$.', revealed: false },
+      { id: 'att2', type: 'Lemma', name: 'Fundamental group of the circle', statement: '$\\pi_1(S^1) \\cong \\mathbb{Z}$, generated by the loop winding once around.', proof: 'Use the covering $p: \\mathbb{R} \\to S^1$, $t \\mapsto e^{2\\pi i t}$; paths and homotopies lift uniquely, and the winding number gives the isomorphism.', revealed: false },
