+    return () => window.removeEventListener('keydown', onKey);
+  }, [onClose]);
+  if (!pool.length) return null;
+  const { course, t } = pool[idx % pool.length];
+  const next = () => {
+    if (pool.length > 1) { let n; do { n = (Math.random() * pool.length) | 0; } while (n === idx); setIdx(n); }
