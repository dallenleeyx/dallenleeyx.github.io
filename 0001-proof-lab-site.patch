@@ -0,0 +1,310 @@
+/* ══════════════════════════════════════════════════════════════════════
+   DALLEN LEE — Design System
+   colors_and_type.css
+
+   Single source of truth for color tokens and type styles.
+   Includes both BASE tokens (--fg1, --serif-display, etc.) and
+   SEMANTIC roles (h1, h2, body, code, …).
+
+   Two themes are supported via [data-theme="dark"|"light"].
+   Default is dark (the original site's preferred theme).
+   ══════════════════════════════════════════════════════════════════════ */
+
+
+/* ──────────────────────────────────────────────────────────────────────
+   FONTS
+   ──────────────────────────────────────────────────────────────────────
+   Loaded via Google Fonts. Local copies live in fonts/ as a backup.
+   Body:  Nunito (300, 400, 500, 600, 700; italic 400, 500)
+   Mono:  DM Mono (300, 400, 500)
+   Math:  KaTeX serves its own fonts via CSS at runtime.
+   ────────────────────────────────────────────────────────────────────── */
+@import url('https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500&family=DM+Mono:wght@300;400;500&display=swap');
+
+
+/* ──────────────────────────────────────────────────────────────────────
+   1. STRUCTURAL / SHAPE TOKENS  (theme-independent)
+   ────────────────────────────────────────────────────────────────────── */
+:root {
+  /* Layout */
+  --sidebar-w: 280px;
+  --content-max-w: 860px;
+  --post-max-w: 720px;
+
+  /* Radii */
+  --radius-xs: 4px;
+  --radius-sm: 8px;
+  --radius-md: 10px;
+  --radius-lg: 14px;
+  --radius-pill: 20px;
+  --radius-full: 50px;
+
+  /* Spacing scale (rem) — used loosely; the system also uses ad-hoc rem values */
+  --space-1: 0.25rem;
+  --space-2: 0.5rem;
+  --space-3: 0.75rem;
+  --space-4: 1rem;
+  --space-5: 1.5rem;
+  --space-6: 2rem;
+  --space-8: 3rem;
+  --space-10: 5rem;
+
+  /* Motion */
+  --transition: 0.22s ease;
+  --transition-fast: 0.18s ease;
+  --transition-slow: 0.6s ease;
+
+  /* Type families */
+  --font-sans: 'Nunito', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
+  --font-mono: 'DM Mono', ui-monospace, 'SF Mono', Menlo, monospace;
+  --font-display: 'Nunito', system-ui, sans-serif;     /* same family, used at large sizes */
+  --font-math: 'DM Mono', monospace;                   /* for inline math glyphs/decoration */
+
+  /* Type scale (rem) */
+  --fs-xs:    0.62rem;   /*  9.92 px — micro labels, tiny tags */
+  --fs-2xs:   0.65rem;   /* 10.40 px — pill labels, course dept */
+  --fs-sm:    0.68rem;   /* 10.88 px — meta, breadcrumbs, deco */
+  --fs-base:  0.72rem;   /* 11.52 px — small UI, links */
+  --fs-md:    0.78rem;   /* 12.48 px — buttons, micro body */
+  --fs-lg:    0.85rem;   /* 13.60 px — bullet copy */
+  --fs-xl:    0.96rem;   /*  ~15.4 px — body */
+  --fs-2xl:   1.05rem;   /* 16.80 px — h3 */
+  --fs-3xl:   1.25rem;   /* 20.00 px — h2 */
+  --fs-4xl:   1.6rem;    /* 25.60 px — small display */
+  --fs-5xl:   2.1rem;    /* 33.60 px — post title */
+  --fs-6xl:   2.8rem;    /* 44.80 px — hero greeting */
+
+  /* Font weights */
+  --fw-light: 300;
+  --fw-regular: 400;
+  --fw-medium: 500;
+  --fw-semibold: 600;
+  --fw-bold: 700;
+  --fw-black: 800;
+
+  /* Tracking (letter-spacing) */
+  --tracking-tight: -0.03em;     /* hero greeting */
+  --tracking-snug: -0.025em;     /* post title */
+  --tracking-normal: 0;
+  --tracking-wide: 0.04em;
+  --tracking-wider: 0.06em;
+  --tracking-widest: 0.07em;
+  --tracking-uppercase: 0.18em;  /* section labels */
+
+  /* Line heights */
+  --lh-tight: 1.15;
+  --lh-snug: 1.4;
+  --lh-base: 1.6;
+  --lh-relaxed: 1.75;
+  --lh-loose: 1.85;
+}
+
+
+/* ──────────────────────────────────────────────────────────────────────
+   2. COLOR TOKENS — DARK (default)
+   ──────────────────────────────────────────────────────────────────────
+   The palette is intentionally MONOCHROMATIC: pure black/white plus
+   five grays. Color = restraint; the math motifs and copy carry the
+   identity instead of hue.
+   ────────────────────────────────────────────────────────────────────── */
+:root,
+[data-theme="dark"] {
+  /* Surfaces (background → elevated) */
+  --bg:        #0c0c0c;   /* page background */
+  --surface:   #141414;   /* cards, sidebar */
+  --surface-2: #1c1c1c;   /* nested fill, tags, code blocks */
+
+  /* Borders / dividers */
+  --border:    #2a2a2a;
+
+  /* Foreground text (decreasing emphasis) */
+  --fg-1:      #f0f0f0;   /* primary text */
+  --fg-2:      #a0a0a0;   /* body / secondary */
+  --fg-muted:  #555555;   /* meta, dates, deco */
+
+  /* Accents (hierarchy of monochrome) */
+  --accent:    #ffffff;   /* primary accent — labels, active nav, CTA fg */
+  --accent-2:  #c0c0c0;   /* secondary accent — links, italic body emphasis */
+  --accent-3:  #e0e0e0;   /* tertiary — status text */
+
+  /* Glow / overlays */
+  --glow:      rgba(255, 255, 255, 0.06);
+  --glow-strong: rgba(255, 255, 255, 0.15);
+
+  /* Shadows */
+  --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.15);
+  --shadow-md: 0 4px 18px var(--glow);
+  --shadow-lg: 0 8px 32px var(--glow);
+  --shadow-glow: 0 2px 18px var(--glow);
+}
+
+/* ──────────────────────────────────────────────────────────────────────
+   3. COLOR TOKENS — LIGHT
+   ────────────────────────────────────────────────────────────────────── */
+[data-theme="light"] {
+  --bg:        #f8f8f8;
+  --surface:   #ffffff;
+  --surface-2: #f0f0f0;
+  --border:    #e0e0e0;
+
+  --fg-1:      #0c0c0c;
+  --fg-2:      #444444;
+  --fg-muted:  #999999;
+
+  --accent:    #000000;
+  --accent-2:  #333333;
+  --accent-3:  #555555;
+
+  --glow:      rgba(0, 0, 0, 0.06);
+  --glow-strong: rgba(0, 0, 0, 0.15);
+
+  --shadow-sm: 0 2px 10px rgba(0, 0, 0, 0.08);
+  --shadow-md: 0 4px 18px var(--glow);
+  --shadow-lg: 0 8px 32px var(--glow);
+  --shadow-glow: 0 2px 18px var(--glow);
+}
+
+
+/* ──────────────────────────────────────────────────────────────────────
+   4. SEMANTIC TYPE STYLES
+   ──────────────────────────────────────────────────────────────────────
+   Use these classes (or extend them in your own selectors) instead of
+   redefining sizes/weights inline.
+   ────────────────────────────────────────────────────────────────────── */
+
+/* Hero / greeting line — "Hi, I'm Dallen." */
+.t-display {
+  font-family: var(--font-display);
+  font-size: var(--fs-6xl);
+  font-weight: var(--fw-bold);
+  line-height: var(--lh-tight);
+  letter-spacing: var(--tracking-tight);
+  color: var(--fg-1);
+}
+
+/* Article / post title */
+.t-h1 {
+  font-family: var(--font-sans);
+  font-size: var(--fs-5xl);
+  font-weight: var(--fw-bold);
+  line-height: 1.2;
+  letter-spacing: var(--tracking-snug);
+  color: var(--fg-1);
+}
+
+/* Section header inside a post */
+.t-h2 {
+  font-family: var(--font-sans);
+  font-size: var(--fs-3xl);
+  font-weight: var(--fw-bold);
+  line-height: var(--lh-snug);
+  letter-spacing: -0.015em;
+  color: var(--fg-1);
+}
+
+/* Sub-section / card title */
+.t-h3 {
+  font-family: var(--font-sans);
+  font-size: var(--fs-2xl);
+  font-weight: var(--fw-bold);
+  color: var(--fg-1);
+}
+
+/* Section LABEL — uppercase, tracked, used above each main section */
+.t-section-label {
+  font-family: var(--font-sans);
+  font-size: var(--fs-sm);
+  font-weight: var(--fw-black);
+  letter-spacing: var(--tracking-uppercase);
+  text-transform: uppercase;
+  color: var(--accent);
+}
+
+/* Body — long-form prose */
+.t-body {
+  font-family: var(--font-sans);
+  font-size: var(--fs-xl);
+  font-weight: var(--fw-regular);
+  line-height: var(--lh-relaxed);
+  color: var(--fg-2);
+}
+
+/* Body small — bullets, descriptions */
+.t-body-sm {
+  font-family: var(--font-sans);
+  font-size: var(--fs-lg);
+  line-height: var(--lh-base);
+  color: var(--fg-2);
+}
+
+/* Italic emphasis on a key term inside body copy */
+.t-em {
+  font-style: normal;
+  font-weight: var(--fw-semibold);
+  color: var(--accent-2);
+}
+
+/* Small caps-ish meta — uppercase, tracked, monochrome */
+.t-eyebrow {
+  font-family: var(--font-sans);
+  font-size: var(--fs-base);
+  font-weight: var(--fw-bold);
+  letter-spacing: var(--tracking-widest);
+  text-transform: uppercase;
+  color: var(--accent);
+}
+
+/* Mono — code, dates, course codes, breadcrumbs */
+.t-mono {
+  font-family: var(--font-mono);
+  font-size: var(--fs-sm);
+  font-weight: var(--fw-medium);
+  letter-spacing: var(--tracking-wide);
+  color: var(--fg-muted);
+}
+
+.t-mono-accent {
+  font-family: var(--font-mono);
+  font-size: var(--fs-base);
+  font-weight: var(--fw-medium);
+  color: var(--accent);
+  letter-spacing: var(--tracking-wide);
+}
+
+/* Inline code */
+.t-code {
+  font-family: var(--font-mono);
+  font-size: 0.85em;
+  background: var(--surface-2);
+  border: 1px solid var(--border);
+  padding: 0.1em 0.4em;
+  border-radius: var(--radius-xs);
+  color: var(--accent-2);
+}
+
+/* Caption / micro */
+.t-caption {
+  font-family: var(--font-sans);
+  font-size: var(--fs-xs);
+  font-weight: var(--fw-bold);
+  letter-spacing: var(--tracking-widest);
+  text-transform: uppercase;
+  color: var(--fg-muted);
+}
+
+
+/* ──────────────────────────────────────────────────────────────────────
+   5. ELEMENT DEFAULTS — opt-in by adding to <body> or a wrapper
+   ────────────────────────────────────────────────────────────────────── */
+.dl-prose {
+  font-family: var(--font-sans);
+  font-size: var(--fs-xl);
+  line-height: var(--lh-relaxed);
+  color: var(--fg-2);
+}
+.dl-prose h1 { @extend .t-h1; }       /* note: PostCSS or just copy these inline if no preprocessor */
+.dl-prose em { color: var(--accent-2); font-style: normal; font-weight: var(--fw-semibold); }
+.dl-prose strong { color: var(--fg-1); font-weight: var(--fw-bold); }
+.dl-prose code { font-family: var(--font-mono); font-size: 0.85em; background: var(--surface-2);
+                 border: 1px solid var(--border); padding: 0.1em 0.4em; border-radius: var(--radius-xs);
+                 color: var(--accent-2); }
